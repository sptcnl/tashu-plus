# ---------------------------------------------------------------------------
# 백엔드 환경변수 (backend/.env 로 복사한 뒤 셸에서 export 하거나
#  docker-compose 의 environment 에 넣어서 사용)
# ---------------------------------------------------------------------------

# DB 연결 문자열. 비우면 SQLite 파일(./tashu.db)을 쓴다.
# PostgreSQL 예시: postgresql+psycopg://tashu:tashu@db:5432/tashu
# DATABASE_URL=

# ---------------------------------------------------------------------------
# 타슈 실시간 대여소 현황 API
#  발급: 타슈 앱 실행 > [자전거정보 > Open API] 메뉴에서 신청
#        (공공데이터포털 https://www.data.go.kr/data/15119663/openapi.do 는
#         LINK 형 안내 페이지라서 그쪽에서는 키가 발급되지 않는다)
#  호출: GET https://bikeapp.tashu.or.kr:50041/v1/openapi/station
#        헤더 `api-token: <키>`
#  비워두면 GET /api/stations 가 seed 데이터를 반환하고 source="seed" 로 표시된다.
# ---------------------------------------------------------------------------
TASHU_API_KEY=

# 엔드포인트를 바꿔야 할 때만 설정 (기본값이 위 URL)
# TASHU_API_URL=https://bikeapp.tashu.or.kr:50041/v1/openapi/station

# 공공 API 재호출 간격(초). 매 요청마다 원본을 때리지 않기 위한 인메모리 캐시 TTL.
TASHU_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# 카카오 REST API 키 (도보/자전거/대중교통 경로 + 키워드 검색)
#  발급: https://developers.kakao.com > 내 애플리케이션 > 앱 설정 > 앱 키 > REST API 키
#  2026-07-21 부터 카카오맵 API 는 별도 신청/심사 없이 사용할 수 있다.
#  비워두면 GET /api/routes/compare 가 직선거리 기반 mock 을 반환하고
#  source="mock" 으로 표시된다.
# ---------------------------------------------------------------------------
KAKAO_REST_KEY=

# 제보가 경로상 '위험구간' 으로 집계되는 반경(미터)
DANGER_RADIUS_M=200

# 외부 API 타임아웃(초)
HTTP_TIMEOUT_SECONDS=5
