# ---------------------------------------------------------------------------
# 프론트엔드 환경변수 (frontend/.env 로 복사해서 사용)
# ---------------------------------------------------------------------------

# 백엔드 API 베이스 URL (뒤에 /api 는 코드에서 붙는다)
# docker-compose 처럼 nginx 가 /api 를 프록시하는 환경에서는 빈 값으로 두면 된다.
VITE_API_URL=http://localhost:8000

# 카카오 JavaScript 키 (지도 렌더링용)
#  발급: https://developers.kakao.com > 내 애플리케이션 > 앱 설정 > 앱 키 > JavaScript 키
#  ★ 반드시 [앱 설정 > 플랫폼 > Web] 에 사이트 도메인을 등록해야 지도가 뜬다.
#     - 로컬 개발:  http://localhost:5173
#     - docker:     http://localhost
#     - 배포 시 실제 배포 도메인도 같은 화면에 추가 등록해야 한다.
#  비워두면 지도는 CSS 폴백(MapFallback)으로 그려지고 나머지 기능은 그대로 동작한다.
VITE_KAKAO_JS_KEY=
